#!/bin/bash
# Starts Raspberry Pi OS's X11 desktop inside the Android host's Wayland
# compositor. Xwayland in rootful mode presents the whole X root window as one
# Wayland surface, so openbox and the desktop run unchanged.
set -u

export HOME=${HOME:-/root}
export USER=${USER:-root}
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=LXDE
export XDG_SESSION_DESKTOP=LXDE
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/rpos}
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
export PATH=${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games}

scale=${DD_SCALE:-1}
case "$scale" in ''|*[!0-9]*) scale=1 ;; esac
[ "$scale" -ge 1 ] || scale=1
[ "$scale" -le 3 ] || scale=3

# The Android compositor runs this guest at a narrower logical size and scales
# it to the screen, so the guest itself stays at 1x.
export GDK_SCALE=1
export GDK_DPI_SCALE=1
export QT_SCALE_FACTOR=1
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export XCURSOR_SIZE=24
export GTK_THEME=PiXtrix
export GTK2_RC_FILES=/etc/gtk-2.0/gtkrc
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe

mkdir -p "$XDG_RUNTIME_DIR" /tmp/.X11-unix /tmp/.ICE-unix
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null
chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null

# Rootful Xwayland. -ac allows the local X clients to connect without xauth.
Xwayland :0 -ac -geometry "${DD_WIDTH:-1280}x${DD_HEIGHT:-800}" &
export DISPLAY=:0
for _ in $(seq 1 100); do
    [ -S /tmp/.X11-unix/X0 ] && break
    sleep 0.1
done

# Xft.dpi stays at 96: GDK_SCALE and QT_SCALE_FACTOR do the scaling, and
# setting both would scale text twice.
cat > "$HOME/.Xresources" <<'ENTRY'
Xft.dpi: 96
Xft.antialias: 1
Xft.hinting: 1
Xft.rgba: rgb
ENTRY
xrdb -merge "$HOME/.Xresources" 2>/dev/null

mkdir -p "$HOME/.config/openbox"
cp -f /etc/xdg/openbox/rpd-rc.xml "$HOME/.config/openbox/rpd-rc.xml" 2>/dev/null

# lxpolkit has no logind session here and shows "No session for pid" at start.
mkdir -p "$HOME/.config/lxsession/rpd-x"
sed 's|^polkit/command=.*|polkit/command=|' \
    /etc/xdg/lxsession/rpd-x/desktop.conf > "$HOME/.config/lxsession/rpd-x/desktop.conf"
mkdir -p "$HOME/.config/autostart"
for agent in lxpolkit polkit-mate-authentication-agent-1; do
    cat > "$HOME/.config/autostart/$agent.desktop" <<'ENTRY'
[Desktop Entry]
Type=Application
Name=polkit agent
Hidden=true
ENTRY
done

# Pi OS's own X11 session: openbox-rpd, lxpanel-pi and pcmanfm-pi.
exec dbus-run-session -- lxsession -s rpd-x -e LXDE
